{
  "name": "gitfusion.ums",
  "version": "1.0.0",
  "description": "User management system for gitfusion",
  "main": "index.js",
  "scripts": {
    "compile": "tsc",
    "compile:build": "tsc --project tsconfig.build.json",
    "start": "npm run compile && node ./dist/index.js",
    "serve": "nodemon",
    "codegen:generate": "graphql-codegen",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "set -a && source .env && set +a && prisma migrate dev",
    "prisma:reset": "set -a && source .env && set +a && prisma migrate reset"
  },
  "type": "module",
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apollo/server": "^4.12.2",
    "@apollo/subgraph": "^2.11.2",
    "@graphql-tools/merge": "^9.0.24",
    "@prisma/client": "^6.10.1",
    "@supabase/supabase-js": "^2.50.0",
    "dotenv": "^16.5.0",
    "graphql": "^16.11.0",
    "graphql-middleware": "^6.1.35",
    "graphql-shield": "^7.6.5",
    "graphql-tag": "^2.12.6",
    "install": "^0.13.0",
    "npm": "^11.4.2",
    "winston": "^3.17.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.5",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-resolvers": "^4.5.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.16",
    "nodemon": "^3.1.9",
    "prisma": "^6.10.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
